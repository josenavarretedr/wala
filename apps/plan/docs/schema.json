  "validationRules": {
    "typesAndRanges": {
      "dni": "Cadena numérica exacta de 8 dígitos (o alfanumérica de hasta 12 para cédulas extranjeras).",
      "batchConfig.batchSize": "Entero estricto mayor a 0 (>0).",
      "marketPurchase.packageCost": "Número de coma flotante positivo (>0).",
      "marketPurchase.quantityInPackage": "Número de coma flotante positivo (>0)."
    },
    "formulas": {
      "unitCostFromMarket": "packageCost / quantityInPackage",
      "costIncurredInBatch": "quantityUsed * unitCostFromMarket",
      "directCostPerUnit": "totalBatchDirectCost / batchSize"
    },
    "budgetRule": {
      "totalBusinessInvestment": "sum(totalPrice de todos los ítems)",
      "allocatedTotal": "sum(totalPrice de ítems con financedBySeedCapital === true)",
      "complianceCondition": "allocatedTotal <= seedCapitalCeiling",
      "isBudgetCompliant": "boolean (true si allocatedTotal <= seedCapitalCeiling; false bloquea la exportación del plan)."
    },
    "canvasRule": {
      "minimumCharactersPerBlock": 15,
      "requiredBlocksCount": 9,
      "completionCondition": "Todos los 9 bloques deben tener text.trim().length >= 15 para marcar la Sesión 5 como completada y desbloquear la Sesión 6."
    }
  }
