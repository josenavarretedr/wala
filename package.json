{
  "name": "wala-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:content": "npm run dev -w content",
    "dev:video": "npm run dev -w video",
    "dev:plan": "npm run dev -w plan",
    "build": "npm run build -w web && npm run build -w content",
    "build:all": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w web",
    "build:content": "npm run build -w content",
    "build:video": "npm run build -w video",
    "build:plan": "npm run build -w plan",
    "preview:web": "npm run preview -w web",
    "preview:content": "npm run preview -w content",
    "preview:plan": "npm run preview -w plan",
    "emulators:start": "firebase emulators:start --import=./emulator-data --export-on-exit=./emulator-data",
    "emulators:export": "firebase emulators:export ./emulator-data --force",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:full": "npm run build && firebase deploy",
    "migrate:guiones": "node scripts/migrateGuiones.js"
  }
}
